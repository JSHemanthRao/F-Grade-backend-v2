{
  "openapi": "3.0.3",
  "info": {
    "title": "Zoho CRM Natural Language Assistant",
    "version": "3.0.0",
    "description": "Read-only natural-language access to live Zoho CRM data. Send the user's complete CRM question unchanged in the question field. The backend resolves intent, module, fields, dates, filters, sorting, aggregation, relationships, activity type, and pagination.",
    "x-copilot-studio-tool-description": "Use this read-only tool only for live Zoho CRM questions. FIRST REQUEST: send question and do not invent conversation_id for a new request. FOLLOW-UP: when a previous CRM response exists and the user asks next 20, next page, show more, continue, next batch, or another 20, pass the exact conversation_id returned by the previous response. Never create, change, or omit conversation_id for an existing query. Do not construct modules, fields, filters, limits, offsets, or COQL. Never emit a Leads field named Converted. Conversion questions must remain natural language and be sent unchanged in question."
  },
  "servers": [
    {
      "url": "https://f-grade-backend-v2.onrender.com",
      "description": "Production backend"
    }
  ],
  "paths": {
    "/api/crm/assistant": {
      "post": {
        "operationId": "askCrmAssistant",
        "summary": "Ask Zoho CRM",
        "x-ms-summary": "Ask Zoho CRM",
        "description": "Pass the user's complete CRM question unchanged. On the first request, omit conversation_id unless the application already has one. For follow-ups such as next 20, next page, show more, continue, next batch, or another 20, pass the exact conversation_id returned by the previous CRM assistant response. Never generate, change, or omit it when continuing an existing query; do not calculate an offset.",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Natural-language CRM request.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssistantRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful read-only CRM response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrmResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamFailure"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header",
        "description": "Backend API key. The server also accepts this value as a Bearer token."
      }
    },
    "schemas": {
      "AssistantRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "x-ms-summary": "Question",
            "description": "The user's complete original natural-language Zoho CRM request. Pass it unchanged; do not rewrite, summarize, translate, interpret, or convert it into structured CRM parameters."
          },
          "conversation_id": {
            "type": "string",
            "minLength": 1,
            "x-ms-summary": "Conversation ID",
             "description": "Optional on the first request. For every pagination follow-up, pass the exact conversation_id returned by the previous response unchanged. Do not generate a new value, change it, or omit it when continuing an existing query."
          }
        }
      },
      "CrmResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "description": "Backend request identifier for tracing."
          },
          "conversation_id": {
            "type": "string",
            "nullable": true
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "description": "Natural-language answer based only on the returned CRM result."
          },
          "module": {
            "type": "string",
            "description": "Canonical CRM module resolved by the backend."
          },
          "module_api_name": {
            "type": "string",
            "description": "Exact Zoho CRM API module name used by the backend."
          },
          "request_type": {
            "type": "string",
            "description": "Normalized read-only operation executed by the backend."
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "returned": {
            "type": "integer",
            "format": "int32"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          },
          "diagnostics": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "offset": {
            "type": "integer",
            "format": "int32"
          },
          "returned": {
            "type": "integer",
            "format": "int32"
          },
          "more_records": {
            "type": "boolean"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "status",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "request_id": {
            "type": "string"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "diagnostics": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid CRM request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Access denied by the CRM provider.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Pagination or continuation state conflict.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Unexpected backend error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UpstreamFailure": {
        "description": "Zoho CRM or another required upstream service could not complete the request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
