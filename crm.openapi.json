{
  "swagger": "2.0",
  "info": {
    "title": "Zoho CRM Structured Query Assistant",
    "version": "1.0.0",
    "description": "Read-only structured JSON access to live Zoho CRM data. The backend resolves the CRM module, fields, filters, dates, operators, relationships, and execution strategy from the natural-language question. Pagination is stateless using only limit and offset.",
    "x-copilot-studio-tool-description": "This tool accepts a structured JSON request that is built from a natural-language Zoho CRM request. The backend determines the CRM module, fields, filters, operators, dates, relationships, sorting, aggregation, and execution strategy. The caller must not provide Zoho API field names unless explicitly required. Pagination uses only limit and offset; Never use continuation_token or conversation_id. For pagination metadata, use pagination.next_offset and do not ask the user for conversation IDs or continuation tokens."
  },
  "host": "f-grade-backend-v2.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "in": "header",
      "name": "x-api-key"
    }
  },
  "security": [
    {
      "api_key": []
    }
  ],
  "paths": {
    "/api/crm/assistant": {
      "post": {
        "operationId": "askCrmAssistant",
        "summary": "Ask Zoho CRM",
        "x-ms-summary": "Ask Zoho CRM",
        "description": "Executes a complete structured CRM JSON request. Pagination is stateless and uses pagination.offset plus pagination.limit.",
        "security": [
          {
            "api_key": []
          }
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "description": "Versioned structured CRM JSON request.",
            "schema": {
              "$ref": "#/definitions/StructuredCrmRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful CRM response.",
            "schema": {
              "$ref": "#/definitions/StructuredCrmResponse"
            }
          },
          "400": {
            "description": "Invalid CRM request.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "403": {
            "description": "Access denied by the CRM provider.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "409": {
            "description": "Query context or pagination conflict.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Unexpected backend error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "502": {
            "description": "Upstream CRM or dependency failure.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "StructuredCrmRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#/definitions/RequestDescriptor"
        }
      }
    },
    "RequestDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "description": "Natural-language Zoho CRM request. The backend resolves the CRM module, fields, filters, operators, dates, relationships, and execution strategy."
        },
        "pagination": {
          "$ref": "#/definitions/PaginationRequest"
        },
        "query_context": {
          "$ref": "#/definitions/QueryContext"
        }
      }
    },
    "QueryDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Zoho CRM API field names to return."
        },
        "filters": {
          "type": "object",
          "description": "Object keyed by field API name. Semantic date operators such as this_month are allowed.",
          "additionalProperties": true
        },
        "sort": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SortDescriptor"
          },
          "description": "Deterministic stable sort list. If omitted, the backend applies Created_Time desc then id desc."
        }
      }
    },
    "FilterDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "description": "CRM filter operator such as equals, between, greater_than, less_than, is_not_null, or semantic date operators such as this_month."
        },
        "value": {
          "description": "Required for value-based operators."
        }
      }
    },
    "SortDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "order"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "order": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    },
    "PaginationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "offset"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 200,
          "default": 20
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "QueryContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_query": {
          "type": "object",
          "description": "Optional previous canonical semantic query for follow-up context. The backend may use it for follow-up questions without exposing internal identifiers."
        }
      }
    },
    "StructuredCrmResponse": {
      "type": "object",
      "required": [
        "success",
        "status",
        "request_id",
        "request",
        "data",
        "pagination",
        "query"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "request": {
          "$ref": "#/definitions/ResponseRequestDescriptor"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "pagination": {
          "$ref": "#/definitions/PaginationResponse"
        },
        "page": {
          "$ref": "#/definitions/PageDescriptor"
        },
        "query": {
          "$ref": "#/definitions/ResponseQueryDescriptor"
        }
      }
    },
    "ResponseRequestDescriptor": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "module_api_name": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        }
      }
    },
    "PaginationResponse": {
      "type": "object",
      "required": [
        "offset",
        "limit",
        "returned",
        "next_offset",
        "has_more"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32"
        },
        "limit": {
          "type": "integer",
          "format": "int32"
        },
        "returned": {
          "type": "integer",
          "format": "int32"
        },
        "next_offset": {
          "type": "integer",
          "format": "int32",
          "x-nullable": true
        },
        "has_more": {
          "type": "boolean"
        }
      }
    },
    "PageDescriptor": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "ResponseQueryDescriptor": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string"
        },
        "request_type": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "sort": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SortDescriptor"
          }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "success",
        "status",
        "request_id",
        "error"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "error"
          ]
        },
        "request_id": {
          "type": "string"
        },
        "error": {
          "$ref": "#/definitions/ErrorDetail"
        }
      }
    },
    "ErrorDetail": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}