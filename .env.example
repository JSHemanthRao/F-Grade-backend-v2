NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*
REQUEST_BODY_LIMIT=100kb
REQUEST_TIMEOUT_MS=60000
CRM_TIMEZONE=Asia/Kolkata
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com/crm/v8
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REQUEST_TIMEOUT_MS=15000
BACKEND_API_URL=http://localhost:3000
BACKEND_API_PATH=/api/crm/assistant
# Used only for protected internal/admin endpoints; bot connector actions are anonymous.
BACKEND_API_KEY=
BACKEND_REQUEST_TIMEOUT_MS=15000
BACKEND_DIAGNOSTICS=false
BOT_RATE_LIMIT_WINDOW_MS=60000
BOT_CRM_RATE_LIMIT=30
BOT_AGGREGATE_RATE_LIMIT=10
BOT_AUDIT_RATE_LIMIT=5
# Set to 1 behind Render's single trusted proxy; use 0 for direct/local access.
TRUST_PROXY_HOPS=0
ZOHO_MAX_RETRIES=2
ZOHO_CIRCUIT_FAILURE_THRESHOLD=3
ZOHO_CIRCUIT_RESET_TIMEOUT_MS=30000
ZOHO_MAX_CONCURRENCY=4
ZOHO_METADATA_TTL_MS=300000
