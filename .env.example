NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*
REQUEST_BODY_LIMIT=100kb
CRM_TIMEZONE=Asia/Kolkata
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com/crm/v8
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REQUEST_TIMEOUT_MS=15000
BACKEND_API_URL=http://localhost:3000
BACKEND_API_PATH=/api/crm/assistant
BACKEND_API_KEY=
BACKEND_REQUEST_TIMEOUT_MS=15000
BACKEND_DIAGNOSTICS=false
ZOHO_MAX_RETRIES=2
ZOHO_CIRCUIT_FAILURE_THRESHOLD=3
ZOHO_CIRCUIT_RESET_TIMEOUT_MS=30000
ZOHO_MAX_CONCURRENCY=4
ZOHO_METADATA_TTL_MS=300000

# Zoho Books (optional; required only when using /api/books routes)
BOOKS_ACCOUNTS_URL=https://accounts.zoho.com
BOOKS_API_BASE_URL=https://www.zohoapis.com/books/v3
BOOKS_CLIENT_ID=
BOOKS_CLIENT_SECRET=
BOOKS_REFRESH_TOKEN=
BOOKS_ORGANIZATION_ID=
