{
  "swagger": "2.0",
  "info": {
    "title": "F-Grade CRM Assistant API",
    "version": "1.0.0",
    "description": "Minimal OpenAPI spec exposing only the assistant endpoint for Copilot Studio testing."
  },
  "host": "https://f-grade-backend-v2.onrender.com",
  "basePath": "/",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/api/crm/assistant": {
      "post": {
        "operationId": "askCrmAssistant",
        "summary": "Answer a natural-language CRM question",
        "description": "Resolves record, count, aggregate, and lead-conversion questions and executes the required queries.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/AssistantRequest" }
          }
        ],
        "responses": {
          "200": { "description": "Assistant response", "schema": { "$ref": "#/definitions/AssistantResponse" } },
          "400": { "description": "Bad request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "502": { "description": "Upstream Zoho error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    }
  },
  "definitions": {
    "AssistantRequest": {
      "type": "object",
      "required": ["question"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "conversation_id": { "type": "string" },
        "query": { "type": "object" }
      }
    },
    "AssistantResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "status": { "type": "string" },
        "module": { "type": "string" },
        "request_type": { "type": "string" },
        "data": { "type": "array", "items": { "type": "object" } },
        "count": { "type": "integer" },
        "total": { "type": "integer" },
        "answer": { "type": "string" },
        "summary": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ErrorResponse": {
      "type": "object",
      "properties": { "success": { "type": "boolean" }, "status": { "type": "string" }, "response": { "type": "string" } },
      "additionalProperties": true
    }
  }
}
