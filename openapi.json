{
  "openapi": "3.0.3",
  "info": {
    "title": "F-Grade CRM Assistant API",
    "version": "1.0.0",
    "description": "Read-only natural-language Zoho CRM assistant for Microsoft Copilot Studio. The backend resolves the explicitly requested module to its exact Zoho API module, validates live module and field metadata, selects an approved read API, and returns normalized CRM data. It never substitutes another module; zero records remain zero records and module errors are returned.",
    "x-copilot-studio-tool-description": "Ask read-only questions about Zoho CRM. The user's explicit module is authoritative: Calls means Calls, Tasks means Tasks, Meetings means Events, Products means Products, and Deals means Deals. Never substitute another module. Never invent fields; resolve fields against the selected module's live metadata. Zero records remain zero records. Return backend module, metadata, or query errors instead of replacing them with another module's data. Never emit a Leads field named Converted; conversion questions must remain natural language."
  },
  "servers": [
    {
      "url": "https://f-grade-backend-v2.onrender.com/",
      "description": "Production server"
    }
  ],
  "paths": {
    "/api/crm/assistant": {
      "post": {
        "operationId": "askCrmAssistant",
        "summary": "Answer a natural-language CRM question",
        "description": "Resolves record, count, aggregate, search, and lead-conversion questions against the exact explicitly requested CRM module. Products never becomes Deals; Meetings maps only to Events. Module availability and query errors are returned without fallback substitution.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AssistantRequest" }
            }
          }
        },
        "security": [{ "apiKeyAuth": [] }],
        "responses": {
          "200": {
            "description": "Assistant response",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssistantResponse" } } }
          },
          "400": {
            "description": "Bad request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "502": {
            "description": "Upstream Zoho error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
          ,
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Read-only operation or permission denied", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    }
    ,
    "/api/crm/assistant/fast-summary": {
      "post": {
        "operationId": "askCrmAssistantFastSummary",
        "summary": "Fast counts-only summary of today's CRM activity",
        "description": "Quick summary that returns counts per module for today's activity. Designed to finish quickly for connector time-limited environments.",
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FastSummaryRequest" } } }
        },
        "security": [{ "apiKeyAuth": [] }],
        "responses": {
          "200": { "description": "Fast summary response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssistantResponse" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Optional when the backend is deployed without BACKEND_API_KEY; required when that environment variable is configured."
      }
    },
    "schemas": {
      "AssistantRequest": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": { "type": "string", "minLength": 1, "description": "Natural-language read-only Zoho CRM question." },
          "prompt": { "type": "string", "description": "Compatibility alias for question." },
          "message": { "type": "string", "description": "Compatibility alias for question." },
          "conversation_id": { "type": "string" },
          "module": { "type": "string", "description": "Exact CRM display module to query. The backend preserves this module and never substitutes another; Meetings maps to Events." },
          "request_type": { "type": "string", "description": "records | count | aggregate | analysis | search | bulk_read" },
          "analysis": { "type": "object", "description": "Optional analysis type and parameters" },
          "query": { "type": "object", "description": "Optional structured query (filters, fields, sort, limit, offset)" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "offset": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      },
      "AssistantResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string" },
          "module": { "type": "string" },
          "module_api_name": { "type": "string" },
          "request_type": { "type": "string" },
          "analysis": { "type": "string" },
          "data": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "count": { "type": "integer" },
          "total": { "type": "integer" },
          "answer": { "type": "string" },
          "metrics": { "type": "object", "additionalProperties": true },
          "summary": { "oneOf": [ { "type": "string" }, { "type": "object", "additionalProperties": true } ] },
          "pagination": { "type": "object", "properties": { "limit": { "type": "integer" }, "offset": { "type": "integer" }, "returned": { "type": "integer" }, "more_records": { "type": "boolean" } }, "additionalProperties": false }
        },
        "additionalProperties": true
      },
      "FastSummaryRequest": {
        "type": "object",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "offset": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string" },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": {}
            },
            "required": ["code", "message"],
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  }
}
