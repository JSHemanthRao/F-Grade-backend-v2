{
  "swagger": "2.0",
  "info": {
    "title": "F-Grade Corporate AI CRM API",
    "version": "1.0.0",
    "description": "Single CRM data retrieval API for the F-Grade Corporate AI Agent. Receives a structured request generated from the user's natural-language CRM request and retrieves live Zoho CRM records. The API is the only CRM API exposed to Copilot Studio. Activity Reports and Audit Logs are not implemented in Phase 1.",
    "x-copilot-studio-tool-description": "Use this API when the user requests live Zoho CRM records. The request must contain the structured request generated by the CRM Prompt. Do not use this API to answer from knowledge alone; call the API when live CRM data is required."
  },
  "host": "REPLACE_WITH_RENDER_HOST",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/crm/query": {
      "post": {
        "operationId": "queryCrm",
        "summary": "Retrieve live CRM data from a structured request",
        "description": "The only CRM operation exposed to Copilot Studio. The backend validates the structured request before retrieving normal CRM records. Natural-language interpretation, prompt filtering, and request decomposition occur outside this API. Activity Reports and Audit Logs are not implemented in Phase 1.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CrmQueryRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CRM records retrieved successfully.",
            "schema": {
              "$ref": "#/definitions/CrmQueryResponse"
            }
          },
          "400": {
            "description": "The structured CRM request failed validation or contains invalid JSON.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "502": {
            "description": "Zoho CRM configuration, authentication, or retrieval failure.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Unexpected backend failure.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "CrmQueryRequest": {
      "type": "object",
      "required": [
        "module",
        "fields"
      ],
      "properties": {
        "module": {
          "type": "string",
          "description": "Supported CRM module name.",
          "enum": [
            "Leads",
            "Contacts",
            "Accounts",
            "Deals",
            "Tasks",
            "Calls",
            "Meetings",
            "Notes",
            "Products",
            "Vendors",
            "Quotes",
            "Sales Orders",
            "Purchase Orders",
            "Campaigns",
            "Renewal Accounts"
          ]
        },
        "fields": {
          "type": "array",
          "description": "Non-empty list of API field names supported by the selected module.",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filters": {
          "type": "array",
          "description": "Optional structured filters. Raw COQL is not accepted.",
          "default": [],
          "items": {
            "$ref": "#/definitions/CrmFilter"
          }
        },
        "sort": {
          "$ref": "#/definitions/CrmSort"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 200,
          "default": 20
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "CrmFilter": {
      "type": "object",
      "required": [
        "field",
        "operator"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "description": "API field name supported by the selected module."
        },
        "operator": {
          "type": "string",
          "enum": [
            "equals",
            "not_equals",
            "contains",
            "starts_with",
            "greater_than",
            "less_than",
            "greater_equal",
            "less_equal",
            "in",
            "between",
            "is_null",
            "is_not_null"
          ]
        },
        "value": {
          "description": "Scalar value for most operators, exactly two scalar values for between, or a non-empty scalar array for in. Omit value for is_null and is_not_null.",
          "x-value-types": [
            "string",
            "number",
            "boolean",
            "array"
          ],
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "CrmSort": {
      "type": "object",
      "required": [
        "field",
        "order"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    },
    "CrmQueryResponse": {
      "type": "object",
      "required": [
        "success",
        "status",
        "module",
        "count",
        "data",
        "pagination"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "example": true
        },
        "status": {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        "module": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "pagination": {
          "$ref": "#/definitions/Pagination"
        }
      }
    },
    "Pagination": {
      "type": "object",
      "required": [
        "limit",
        "offset",
        "more_records"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "more_records": {
          "type": "boolean"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "success",
        "status",
        "error"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "error"
          ]
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
